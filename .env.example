# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/tikpad.db

# ---- Solana ----
# Leave TREASURY_SECRET_KEY empty to run in DEMO mode (no chain interaction).
# Base58 secret key (Phantom export) or a JSON byte array (solana-keygen).
TREASURY_SECRET_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- IPFS (token image + metadata). Required for real launches. ----
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# ---- TikTok Login Kit (creator sign-in). Optional: demo sign-in is used when unset. ----
# Create an app at https://developers.tiktok.com, add Login Kit, set the redirect URL to
# $NEXT_PUBLIC_APP_URL/api/auth/tiktok/callback and request the user.info.basic + user.info.profile scopes.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Economics ----
CREATOR_SHARE_BPS=8000          # 80% of claimed fees to the creator
LAUNCH_FEE_LAMPORTS=0           # flat TikPad launch fee
LAUNCH_NETWORK_LAMPORTS=30000000  # 0.03 SOL reserve for pump.fun creation + priority fees
PRIORITY_FEE_SOL=0.0005
MAX_DEV_BUY_SOL=5
EST_CREATOR_FEE_BPS=30
SOL_USD=150                     # fallback if the price feed is unreachable
WORKER_INTERVAL_MS=300000       # claim + payout every 5 minutes
DEMO_SIMULATE=1                 # in demo mode, the worker fakes fee claims
