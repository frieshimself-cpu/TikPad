# ---- AI-image gate (at least one detector is required for launches to be enabled) ----
# Claude looks at every coin image and judges whether it is AI-generated.
ANTHROPIC_API_KEY=
# Optional second opinion: Sightengine's "genai" model.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Block when any detector's AI probability reaches this (0–1). Default 0.5.
AI_BLOCK_THRESHOLD=0.5
# Dangerous: allow launches with only the file-metadata check when no detector key is set.
AI_GATE_ALLOW_METADATA_ONLY=
# Any random string; signs short-lived verdict/launch tokens so detectors run once per image.
APP_SECRET=

# ---- Metadata hosting ----
# Optional Pinata JWT to pin image + metadata on IPFS. Without it pump.fun's own uploader is used.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
# Public URL of this deployment (self-hosted metadata fallback). Auto-detected on Vercel.
NEXT_PUBLIC_APP_URL=

# ---- Solana ----
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Database (optional, Turso / libsql). Lists launched coins and gate totals. ----
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_PATH=./data/realpad.db

# ---- Launch parameters passed to PumpPortal ----
PRIORITY_FEE_SOL=0.0005
SLIPPAGE_PCT=10
MAX_DEV_BUY_SOL=10
