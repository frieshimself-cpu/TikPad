# ---- Required for real launches ----
# Secret key of the treasury wallet aCKyUCgUMfeScz1M9AsMzGZcJxB2EikTGgaftromUz1.
# Base58 (Phantom export) or JSON byte array (solana-keygen). The server refuses to
# start launches if this key belongs to any other wallet.
TREASURY_SECRET_KEY=
# Pinata JWT for uploading token image + metadata to IPFS (pump.fun needs a metadata URI).
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# ---- Solana ----
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Database (Turso / libsql). Required on Vercel so launch quotes and the token list persist. ----
# Locally a file at DATABASE_PATH is used when unset.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_PATH=./data/fanspad.db

# ---- Claim cron auth: Vercel sends it as a bearer token to /api/cron/claim ----
CRON_SECRET=

# ---- Launch economics ----
LAUNCH_NETWORK_LAMPORTS=30000000   # 0.03 SOL reserve for pump.fun creation + priority fees
LAUNCH_FEE_LAMPORTS=0              # flat fee kept per launch
PRIORITY_FEE_SOL=0.0005
SLIPPAGE_PCT=10
MAX_DEV_BUY_SOL=10
